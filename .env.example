# Copia a .env o ejecuta npm run setup. Nunca subas .env a Git.
NODE_ENV=development
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=myspa
WEB_ORIGIN=http://localhost:5173
# Solo se usa en este proyecto local; el setup genera una contraseña segura automáticamente.
SESSION_SECRET=
# Email opcional: si se deja en blanco, no se envían correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MySpa Biblioteca <no-reply@myspa.local>
